# hango.kr MVP 환경변수
PORT=4200
NODE_ENV=production

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hango_app
DB_PASSWORD=change_me
DB_NAME=hango

# 신뢰할 프록시 (Apache 리버스 프록시 뒤에 있으므로 1)
TRUST_PROXY=1

# 관리자 대시보드 접근 토큰 (/admin/stats?token=...)
ADMIN_TOKEN=change_me_long_random

# 결과지 이메일 발송 (기본: 로컬 Postfix sendmail)
MAIL_FROM=no-reply@hango.kr
# Gmail SMTP 사용 시 (권장 - 인박스 수신 안정적):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=cool2466@gmail.com
# SMTP_PASS=<앱 비밀번호>
